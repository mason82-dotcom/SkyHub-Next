# Do not commit .env. Create secrets with: openssl rand -hex 32
SKYHUB_VIEW_TOKEN=REPLACE_WITH_RANDOM_TOKEN
SKYHUB_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SKYHUB_MINIO_USER=skyhub_next_admin
SKYHUB_MINIO_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Optional reviewed ARM64 image for shared storage; historical 2023 default is blocked by pi-minio-network.sh apply.
# SKYHUB_MINIO_IMAGE=registry.example.invalid/approved-minio:PINNED_TAG
# Legacy default: EMQX/1884. No broker is started by SkyHub Next.
# Mosquitto requires coordinated EXPLICIT changes on the private Pi .env:
# SKYHUB_MQTT_BROKER_KIND=mosquitto, SKYHUB_MQTT_REQUIRED_PORT=1883,
# MQTT_BROKER_URL=mqtt://host.docker.internal:1883 and RC-reachable Pilot MQTT :1883.
# Authenticated dedicated Mosquitto: SKYHUB_MQTT_BROKER_KIND=mosquitto-dedicated with port 1884
# (see docs/pi-mosquitto-migration.md and scripts/pi-mosquitto-dedicated.js).
# Do not switch before broker ACL, Docker-host reachability and Pilot 2 checks.
SKYHUB_MQTT_BROKER_KIND=emqx
SKYHUB_MQTT_REQUIRED_PORT=1884
MQTT_BROKER_URL=mqtt://host.docker.internal:1884
MQTT_USER=REPLACE_WITH_BROKER_USERNAME
MQTT_PASSWORD=REPLACE_WITH_BROKER_PASSWORD
SKYHUB_BIND_ADDRESS=127.0.0.1
SKYHUB_HTTP_PORT=4001

# DJI Pilot 2 bootstrap (optional, initially disabled)
# Important: do NOT enable while the backend is published to 0.0.0.0:4000.
# A Caddy HTTPS route to a loopback-only backend is required for live bootstrap.
SKYHUB_PILOT_ENABLED=false
SKYHUB_PILOT_ACCESS_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX
SKYHUB_DJI_APP_ID=REPLACE_WITH_DJI_CLOUD_APP_ID
SKYHUB_DJI_APP_KEY=REPLACE_WITH_DJI_CLOUD_APP_KEY
SKYHUB_DJI_APP_LICENSE=REPLACE_WITH_DJI_CLOUD_LICENSE
SKYHUB_PILOT_MQTT_URL=mqtt://192.168.178.63:1884
SKYHUB_PILOT_MQTT_USER=REPLACE_WITH_PILOT_USER
SKYHUB_PILOT_MQTT_PASSWORD=REPLACE_WITH_PILOT_PASSWORD
SKYHUB_PILOT_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
# Optional read-only S3 media API (off by default). Needs a dedicated read-only MinIO user,
# never the MinIO root credentials above.
# SKYHUB_MEDIA_ENABLED=true
# SKYHUB_S3_ENDPOINT=http://minio:9000
# SKYHUB_S3_ACCESS_KEY=REPLACE_WITH_READONLY_ACCESS_KEY
# SKYHUB_S3_SECRET_KEY=REPLACE_WITH_READONLY_SECRET_KEY
# Optional WPML mission library on MinIO (off by default): validated, write-once KMZ
# files in bucket skyhub-wpml. Uses the EXISTING backend account above (SKYHUB_S3_*);
# scripts/pi-minio-wpml-store.sh adds rights on skyhub-wpml/missions/ only (no delete).
# Not a DJI flight task / dispatch.
# SKYHUB_WPML_STORE_ENABLED=true
# Opt-in: token-free WPML editor on one or more explicitly allowlisted HTTPS LAN origins.
# Requires SKYHUB_LAN_VIEW_CIDR and trusted Caddy proxy; write requests must be same-origin.
# Never allow public origins: all LAN clients can store validated KMZ missions when enabled.
SKYHUB_WPML_LAN_NO_TOKEN_ENABLED=false
SKYHUB_WPML_LAN_ORIGINS=
# SKYHUB_WPML_S3_BUCKET=skyhub-wpml
# Optional overrides (normally empty): own endpoint or own account
# SKYHUB_WPML_S3_ENDPOINT=
# SKYHUB_WPML_S3_ACCESS_KEY=
# SKYHUB_WPML_S3_SECRET_KEY=
# Optional DJI Thermal SDK (dji_irp via box64, Pi 5): compose profile "thermal-sdk".
# The SDK is NOT shipped (DJI license): unpack it locally and point SKYHUB_DJI_TSDK_DIR at it.
# Token: random, min. 32 characters (e.g. openssl rand -hex 32); shared by backend and service.
# SKYHUB_DJI_TSDK_DIR=/home/USER/.local/opt/dji-tsdk
# SKYHUB_THERMAL_SDK_URL=http://thermal-sdk:8790
# SKYHUB_THERMAL_SDK_TOKEN=REPLACE_WITH_RANDOM_64_HEX
# DJI Pilot 2 wayline library (DJI Cloud API wayline/api/v1): list + presigned download.
# Needs the store above, the Pilot 2 HTTPS proxy and an RC-reachable S3 endpoint
# (empty: reuse SKYHUB_PILOT_MEDIA_S3_PUBLIC_ENDPOINT). Keep OFF until tested on the RC.
# SKYHUB_PILOT_WAYLINE_ENABLED=false
# Missionsfreigabe (04.11.2026, docs/entwurf-missionsfreigabe-ndvi-tak-2026-11-04.md): Pilot 2 sieht NUR geprüfte und
# ausdrücklich freigegebene Routen. Ohne Freigabe-Funktion bleibt die Pilot-2-Bibliothek leer (fail-closed).
# Freigeben/Zurückziehen braucht zusätzlich dieses Token im Header X-SkyHub-Release-Token (>= 32 Zeichen, nicht = SKYHUB_VIEW_TOKEN).
# Braucht PostgreSQL (DATABASE_URL). Grenzen dürfen nur verschärft werden (Standard 120 m, 15 m/s, 25 min, 2000 m).
# SKYHUB_MISSION_RELEASE_ENABLED=false
# SKYHUB_MISSION_RELEASE_TOKEN=
# SKYHUB_MISSION_RELEASE_HOURS=72
# SKYHUB_MISSION_MAX_HEIGHT_M=120
# SKYHUB_MISSION_MAX_RTH_HEIGHT_M=120
# SKYHUB_MISSION_MAX_SPEED_MS=15
# SKYHUB_MISSION_MAX_DURATION_MIN=25
# SKYHUB_MISSION_MAX_DISTANCE_M=2000
# Live-Steuerung (DRC) für EINE DJI RC Plus 2 + Matrice 4E/4T (docs/drc-matrice4.md). Standard aus.
# Während der Cloud-Steuerung sind Knüppel, Rückkehr- und Not-Aus-Taste der RC wirkungslos (DJI). SkyHub gibt die Kontrolle bei
# Bedienerverlust nach 1,5 s + 3 s an die RC zurück. Eigenes Token (>= 32 Zeichen, anders als View- und Freigabe-Token).
# SKYHUB_DRC_ENABLED=false
# SKYHUB_DRC_TOKEN=
# SKYHUB_DRC_GATEWAY_SN=                      # Seriennummer der RC Plus 2 (nur diese wird gesteuert)
# SKYHUB_DRC_MQTT_URL=mqtt://mosquitto:1884   # Backend-Verbindung, Benutzer mit Schreibrecht services/drc/down/events_reply
# SKYHUB_DRC_MQTT_USERNAME=skyhub_commander
# SKYHUB_DRC_MQTT_PASSWORD=
# SKYHUB_DRC_BROKER_ADDRESS=192.168.178.63:1884   # wie die RC den Broker erreicht (drc_mode_enter.mqtt_broker.address)
# SKYHUB_DRC_BROKER_USERNAME=skyhub_drc_link
# SKYHUB_DRC_BROKER_PASSWORD=
# SKYHUB_DRC_BROKER_TLS=false
# Grenzen (dürfen nur enger werden): 10 m/s (max 15), 120 m, 2000 m, Knüppelausschlag 0.5 (0.1..1)
# SKYHUB_DRC_MAX_SPEED_MS=10
# SKYHUB_DRC_MAX_HEIGHT_M=120
# SKYHUB_DRC_MAX_DISTANCE_M=2000
# SKYHUB_DRC_STICK_SCALE=0.5
# SKYHUB_DRC_CALLSIGN=SkyHub Leitstand
# Wayline downloads for Pilot 2: use the Pi's IPv4 address, not rpi5.fritz.box. The name also resolves to IPv6, Android
# prefers IPv6, and Caddy on :9446 only admits 192.168.178.0/24 -> 403 -> "Netzwerkfehler (100)" on the RC (05.11.2026).
# The IP literal gets Caddy's internal certificate for 192.168.178.63 (same local CA the RC already trusts).
# SKYHUB_WPML_S3_PUBLIC_ENDPOINT=https://192.168.178.63:9446
# Verified Pilot 2 library. Requires migrations 003-005 on the target DB, the
# configured Pilot workspace and HTTPS proxy. Keep OFF during preparation.
SKYHUB_MEDIA_LIBRARY_ENABLED=false
# SKYHUB_MEDIA_LIBRARY_CURSOR_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# DJI Pilot 2 media synchronisation (RC Plus 2 / RC Pro), MANUAL upload from the Pilot 2 album only
# (automatic upload is forced off). Uploaded photos and videos go straight into
# MinIO dji-cloud/<workspace>/media/<session>/ and appear in the media gallery.
# 1. bash scripts/pi-minio-pilot-uploader.sh apply   (dedicated upload-only MinIO account, prints the .env lines)
# 2. sudo bash scripts/pi-caddy-pilot-media.sh apply (routes /storage/api, /media/api and the S3 endpoint :9446)
# 3. SKYHUB_PILOT_PUBLIC_URL=https://rpi5.fritz.box and the lines below, then scripts/pi-update-backend.sh
SKYHUB_PILOT_MEDIA_UPLOAD_ENABLED=false
# IPv4 address, not rpi5.fritz.box: the name also resolves to IPv6, Android prefers it, and Caddy on :9446 only admits
# 192.168.178.0/24 (403 for every upload over IPv6). Same reason as SKYHUB_WPML_S3_PUBLIC_ENDPOINT (05.11.2026).
# SKYHUB_PILOT_MEDIA_S3_PUBLIC_ENDPOINT=https://192.168.178.63:9446
# SKYHUB_PILOT_UPLOAD_S3_ACCESS_KEY=skyhub-pilot-uploader
# SKYHUB_PILOT_UPLOAD_S3_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Situation Awareness (TSA): disabled until HTTPS reverse proxy and real Pilot 2 are validated.
SKYHUB_DJI_TSA_ENABLED=false
SKYHUB_PILOT_PUBLIC_URL=
# IP of the immediate HTTPS proxy as seen INSIDE the backend container.
# Default trusts loopback only; a Docker bridge gateway must be explicitly configured.
# Exact IPs only: no wildcards, CIDRs or whole private ranges.
SKYHUB_DJI_TSA_TRUSTED_PROXY_IPS=127.0.0.1,::1

# DJI map-group GET route; OFF until the isolated schema migration and Pilot API module are validated.
SKYHUB_DJI_MAP_ELEMENTS_ENABLED=false

# DJI Pilot 2 situation awareness (TSA): pushes fleet positions/presence to paired RCs over
# wss://<public origin>/ws/tsa and serves GET /manage/api/v1/workspaces/{id}/devices/topologies.
# OFF until Caddy routes /ws/tsa and /manage/api/* (scripts/pi-caddy-pilot-tsa.sh) and a hardware test.
# Pilot 2 puts the device token into the WebSocket URL: the Caddy script removes it from access logs.
SKYHUB_DJI_TSA_ENABLED=false
SKYHUB_PILOT_PUBLIC_URL=https://rpi5.fritz.box

# DJI topology acknowledgements: OFF until ACL and hardware validation.
# Pilot 2 expects status_reply to update_topo; without it no OSD was observed (RC Pro, 2026-10-20).
# Create a separate broker account whose only write ACL is sys/product/+/status_reply.
# Never use SKYHUB_PILOT_MQTT_USER as the server publisher account.
SKYHUB_TOPOLOGY_ACK_ENABLED=false
SKYHUB_TOPOLOGY_ACK_MQTT_USER=
SKYHUB_TOPOLOGY_ACK_MQTT_PASSWORD=

# Token-free, read-only dashboard from one private home network (via Caddy :4443).
# Leave empty to always require SKYHUB_VIEW_TOKEN.
SKYHUB_LAN_VIEW_CIDR=
# OPTIONAL: exact *socket peer* IP of a separately verified Caddy reverse proxy.
# Without this, only loopback (127.0.0.1/::1) is trusted for X-Forwarded-*.
# For Docker gateway Caddy, inspect the real container remote peer first and pin it.
# Do NOT specify CIDRs, entire RFC1918/Docker subnets, or public/client IPs.
# On the Pi Caddy arrives from the Docker gateway of skyhub-next_default: run scripts/pi-proxy-peer-check.sh for the value
# (pi-update-backend.sh checks it before every update).
SKYHUB_TRUSTED_PROXY_IPS=

# false: do not store new flight-track positions or auto-prune history.
# Live OSD, map, topology and existing track reads are unaffected.
SKYHUB_TRACK_RECORDING_ENABLED=false
# Days of track history kept in PostGIS when recording is on (1-3650).
SKYHUB_TRACK_RETENTION_DAYS=30
# Offline-Kartenkacheln (OpenStreetMap): false = Weiterleitung zu tile.openstreetmap.org wie bisher.
# true = einmal angesehene Kacheln werden auf dem Pi gespeichert und sind ohne Internet weiter sichtbar.
# Kein Vorab-/Massendownload (OSMF-Tile-Policy). Groesse 16-20480 MB.
SKYHUB_TILE_CACHE_ENABLED=false
SKYHUB_TILE_CACHE_MAX_MB=512

# FH-Clone FC0 passive RTK/flight observer (always in-process, no database writes).
# MSDK ingress is disabled unless this option and an independent HTTPS token are set.
SKYHUB_FH_MSDK_OBSERVER_ENABLED=false
SKYHUB_FH_MSDK_OBSERVER_TOKEN=
# Optional internal UgCS HTTP bridge; blank keeps it disabled.
SKYHUB_FH_UGCS_URL=

# DJI Pilot 2 Livestream (RC -> RTMP -> MediaMTX -> HLS im Dashboard). Standard: aus.
# Aktivieren: SKYHUB_LIVE_ENABLED=true; scripts/pi-compose.sh nimmt dann docker-compose.live.yml dazu.
# Beide Passwoerter: mind. 24 Zeichen [A-Za-z0-9_-], verschieden (z. B. openssl rand -hex 24).
# MediaMTX akzeptiert bei LEEREM Passwort jedes Passwort - deshalb sind beide Pflicht.
SKYHUB_LIVE_ENABLED=false
# RTMP-Adresse, die die Fernsteuerung im LAN erreicht (ohne Pfad/Zugangsdaten).
SKYHUB_LIVE_RTMP_URL=rtmp://192.168.178.63:1935
SKYHUB_LIVE_PUBLISH_PASS=
SKYHUB_LIVE_READ_PASS=
# Optional: Host-Bindung/Port fuer RTMP (Standard 0.0.0.0:1935).
# SKYHUB_LIVE_RTMP_BIND=192.168.178.63
# SKYHUB_LIVE_RTMP_PORT=1935
