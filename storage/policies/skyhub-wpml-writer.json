{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWpmlMissions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-wpml"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "missions/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteOnceWpmlMissions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-wpml/missions/*"
      ]
    }
  ]
}
