{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::basemaps",
        "arn:aws:s3:::dji-cloud",
        "arn:aws:s3:::farming",
        "arn:aws:s3:::mapping-results",
        "arn:aws:s3:::pv-inspections"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::basemaps/*",
        "arn:aws:s3:::dji-cloud/*",
        "arn:aws:s3:::farming/*",
        "arn:aws:s3:::mapping-results/*",
        "arn:aws:s3:::pv-inspections/*"
      ]
    }
  ]
}
